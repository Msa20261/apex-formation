-- MODULE 1.3 - LES BOUCLES (SOQL)
-- En SOQL, on ne fait pas de boucle mais on récupère plusieurs lignes d'un coup
-- Lance chaque requête séparément dans Developer Console > Query Editor

-- QUESTION 1
-- Récupère les 5 premières maisons (nom + ville)
-- Remplace ??? par le bon nombre
SELECT Name, City__c
FROM House__c
LIMIT ???

-- QUESTION 2
-- Récupère toutes les maisons et trie-les par nom (ordre alphabétique)
-- Remplace ??? par le bon champ de tri
SELECT Name, City__c
FROM House__c
ORDER BY ???

-- QUESTION 3
-- Récupère les maisons triées du prix le plus cher au moins cher
-- Remplace ??? par le champ et l'ordre (DESC = décroissant)
SELECT Name, Price__c
FROM House__c
ORDER BY ??? DESC
