-- EXERCICE FINAL - REQUÊTES SOQL - CORRECTION
-- Lance chaque requête séparément dans Developer Console > Query Editor

-- REQUÊTE 1 : Liste complète triée par prix croissant
SELECT Name, Price__c, Bedroom__c, City__c
FROM House__c
WHERE Price__c > 0
ORDER BY Price__c ASC

-- REQUÊTE 2 : Statistiques globales en une seule requête
SELECT COUNT(), MIN(Price__c), MAX(Price__c), AVG(Price__c)
FROM House__c
WHERE Price__c > 0

-- REQUÊTE 3 : Top 3 maisons les plus chères
SELECT Name, Price__c, City__c
FROM House__c
WHERE Price__c > 300000
ORDER BY Price__c DESC
LIMIT 3
