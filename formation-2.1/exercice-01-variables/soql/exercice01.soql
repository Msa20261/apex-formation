-- --- TODO 1 ---
-- Récupère le nom et la ville de toutes tes maisons
-- Remplace les ??? par les bons noms de champs
SELECT Name, City__c
FROM House__c

-- --- TODO 2 ---
-- Récupère tous ces champs : Id, Name, Address__c, City__c, State__c, Zip__c
-- Limite le résultat à 10 enregistrements
SELECT Id, Name, Address__c, City__c 
FROM House__c
LIMIT 10

